{
  "name": "tomilite-dsh-plugin",
  "version": "0.1.0",
  "description": "DeepSeek Harness plugin: give your DSH agent access to your local TomiLite tasks, notes, and project stats",
  "license": "MIT",
  "author": "Tomatovector",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xxwj225-James/tomilite-dsh-plugin.git"
  },
