  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.0",
    "@deepseek-ai/dsh-tools": "0.1.0-rc.7",
    "@types/node": "^26.2.0",
    "typescript": "^5.4.0"
  },
  "scripts": {
    "build": "tsc",
    "prepare": "tsc",
    "test": "node test/smoke.mjs && node test/cordis-load.mjs",
    "test:integration": "node test/integration.mjs"
  }
